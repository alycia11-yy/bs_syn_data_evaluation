# Stage 1 — dataset check (reviewer1..4 + admin). Built from the same repo as Dockerfile.study.
#   docker build -f Dockerfile.review -t doctamper-review .
FROM python:3.12-slim

WORKDIR /app
ENV APP_ENV=production PORT=8080 DATA_DIR=/app/data \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Code only. Mounted at runtime: data/stage1_split (the reviewer folders, read-only),
# data/stage1 (decisions, writable) and config/users.json. The reviewer folders carry
# their own manifest.jsonl, so the full datasets are not needed on the server.
COPY core/ ./core/
COPY auth/ ./auth/
COPY review/ ./review/
COPY scripts/export_stage1.py ./scripts/
COPY review_app.py create_user.py ./
COPY config/datasets.json config/users.example.json ./config/

RUN addgroup --gid 10001 appuser \
    && adduser --uid 10001 --gid 10001 --disabled-password --gecos "" appuser \
    && mkdir -p /app/.nicegui /app/data/stage1 /app/data/stage1_split /app/results \
    && chown -R appuser:appuser /app
USER 10001:10001
EXPOSE 8080
CMD ["python", "review_app.py", "--users", "--host", "0.0.0.0", "--port", "8080"]
