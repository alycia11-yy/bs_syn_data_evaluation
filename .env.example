# Copy to .env next to docker-compose.yml on the server (never commit .env).
# Generate the secret once: python3 -c 'import secrets; print(secrets.token_hex(32))'
NICEGUI_STORAGE_SECRET=change-me
# Where the uploaded study_data/ folder is (default: next to docker-compose.yml)
# STUDY_DATA_DIR=./study_data
# Published address (default 127.0.0.1:8080, for the reverse proxy)
# STUDY_BIND=127.0.0.1
# STUDY_PORT=8080
# 0 only for a plain-HTTP test on an internal network
# HTTPS_ONLY=1
# A Python base image from your own registry, if Docker Hub is not reachable
# BASE_IMAGE=python:3.12-slim
